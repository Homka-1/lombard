{
  "$meta": {
    "name": "Ломбард онлайн — дизайн-токены",
    "version": "2.0.0",
    "concept": "Минимализм и точность: светлая бумага, графитовый текст, один акцент — малахит; плоские поверхности без теней, глубина — обводкой 1px; золото — только в клейме пробы",
    "units": "px (в Illustrator 1px = 1pt)"
  },
  "color": {
    "malachite-950": "#072620",
    "malachite-900": "#0B3A30",
    "malachite-800": "#0F4A3D",
    "malachite-700": "#136150",
    "malachite-600": "#1B7A65",
    "malachite-300": "#8FBFAE",
    "malachite-100": "#DCEAE3",
    "malachite-50": "#EEF5F1",
    "gold-700": "#8A6A2B",
    "gold-500": "#B08A3E",
    "gold-300": "#D9C08A",
    "gold-100": "#F3EBD7",
    "paper": "#F2F4F0",
    "surface": "#FFFFFF",
    "surface-sunken": "#E8ECE7",
    "graphite-900": "#18221F",
    "graphite-700": "#33403B",
    "graphite-500": "#5B6963",
    "graphite-400": "#7E8B85",
    "line": "#CDD5CF",
    "line-strong": "#A9B4AD",
    "info-700": "#245785",
    "info-100": "#E1EBF5",
    "success-700": "#2B6E45",
    "success-100": "#DFF0E4",
    "warning-700": "#9A6212",
    "warning-100": "#F8EAD2",
    "danger-700": "#A8322A",
    "danger-100": "#F7E0DD",
    "neutral-700": "#4F5B56",
    "neutral-100": "#E6EAE7",
    "white": "#FFFFFF",
    "photo-bg": "#D7DED8",
    "photo-bg-dark": "#22302B"
  },
  "semantic": {
    "bg": "paper",
    "bg-inverse": "malachite-900",
    "text": "graphite-900",
    "text-muted": "graphite-500",
    "text-inverse": "white",
    "primary": "malachite-700",
    "primary-hover": "malachite-800",
    "primary-soft": "malachite-100",
    "accent-metal": "gold-500",
    "border": "line",
    "focus": "malachite-300"
  },
  "font": {
    "display": {
      "family": "Spectral",
      "fallback": "Georgia, 'Times New Roman', serif",
      "role": "Заголовки и суммы денег — гравированные цифры как на банкноте",
      "postscript": { "300": "Spectral-Light", "400": "Spectral-Regular", "500": "Spectral-Medium", "600": "Spectral-SemiBold" },
      "files": { "300": "fonts/Spectral-300.ttf", "400": "fonts/Spectral-400.ttf", "500": "fonts/Spectral-500.ttf", "600": "fonts/Spectral-600.ttf" }
    },
    "text": {
      "family": "Golos Text",
      "fallback": "'Segoe UI', Arial, sans-serif",
      "role": "Интерфейс и основной текст — русская гротескная гарнитура для экранов",
      "postscript": { "400": "GolosText-Regular", "500": "GolosText-Medium", "600": "GolosText-SemiBold", "700": "GolosText-Bold" },
      "files": { "400": "fonts/GolosText-400.ttf", "500": "fonts/GolosText-500.ttf", "600": "fonts/GolosText-600.ttf", "700": "fonts/GolosText-700.ttf" }
    }
  },
  "typography": {
    "display":    { "font": "display", "weight": 400, "size": 68, "lineHeight": 72, "tracking": -20 },
    "h1":         { "font": "display", "weight": 400, "size": 48, "lineHeight": 54, "tracking": -15 },
    "h2":         { "font": "display", "weight": 400, "size": 36, "lineHeight": 42, "tracking": -10 },
    "h3":         { "font": "text", "weight": 600, "size": 22, "lineHeight": 28, "tracking": -5 },
    "h4":         { "font": "text", "weight": 600, "size": 17, "lineHeight": 24, "tracking": 0 },
    "lead":       { "font": "text", "weight": 400, "size": 19, "lineHeight": 29, "tracking": 0 },
    "body":       { "font": "text", "weight": 400, "size": 16, "lineHeight": 24, "tracking": 0 },
    "body-strong":{ "font": "text", "weight": 600, "size": 16, "lineHeight": 24, "tracking": 0 },
    "small":      { "font": "text", "weight": 400, "size": 14, "lineHeight": 20, "tracking": 0 },
    "small-strong":{ "font": "text", "weight": 600, "size": 14, "lineHeight": 20, "tracking": 0 },
    "caption":    { "font": "text", "weight": 500, "size": 12, "lineHeight": 16, "tracking": 10 },
    "label":      { "font": "text", "weight": 500, "size": 13, "lineHeight": 18, "tracking": 0 },
    "button":     { "font": "text", "weight": 600, "size": 15, "lineHeight": 20, "tracking": 0 },
    "amount-xl":  { "font": "display", "weight": 500, "size": 56, "lineHeight": 60, "tracking": -20 },
    "amount-l":   { "font": "display", "weight": 500, "size": 36, "lineHeight": 42, "tracking": -10 },
    "amount-m":   { "font": "display", "weight": 500, "size": 24, "lineHeight": 30, "tracking": -5 },
    "hallmark":   { "font": "display", "weight": 600, "size": 20, "lineHeight": 24, "tracking": 40 },
    "logo":       { "font": "display", "weight": 500, "size": 22, "lineHeight": 26, "tracking": -5 }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96, "30": 120 },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999,
    "_note": "Небольшие радиусы: поле 6, кнопка 8, карточка 12, бейдж — пилюля"
  },
  "shadow": {
    "none": "none",
    "_note": "Плоский стиль: теней нет ни в макете, ни во фронтенде. Глубина — обводкой border.hairline цветом line, фокус — кольцом border.focus"
  },
  "border": { "hairline": 1, "strong": 1.5, "focus": 2 },
  "grid": {
    "desktop": { "width": 1440, "columns": 12, "content": 1200, "margin": 120, "gutter": 24 },
    "tablet":  { "width": 768,  "columns": 8,  "content": 704,  "margin": 32,  "gutter": 16 },
    "mobile":  { "width": 375,  "columns": 4,  "content": 343,  "margin": 16,  "gutter": 12 },
    "baseline": 4
  },
  "breakpoints": { "mobile": 360, "tablet": 768, "desktop": 1200, "wide": 1440 },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "360ms",
    "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "_note": "Анимации короткие и сдержанные: плавное появление и смена состояния, без эффектов"
  },
  "status": {
    "DRAFT":             { "label": "Черновик",               "tone": "neutral" },
    "SUBMITTED":         { "label": "Отправлена",             "tone": "info" },
    "PRE_ESTIMATED":     { "label": "Предоценка готова",      "tone": "info" },
    "UNDER_REVIEW":      { "label": "У эксперта",             "tone": "info" },
    "NEED_INFO":         { "label": "Нужны фото",             "tone": "warning" },
    "OFFER_SENT":        { "label": "Предложение",            "tone": "gold" },
    "OFFER_ACCEPTED":    { "label": "Предложение принято",    "tone": "success" },
    "OFFER_DECLINED":    { "label": "Отказ клиента",          "tone": "neutral" },
    "REJECTED":          { "label": "Отклонена",              "tone": "danger" },
    "COURIER_SCHEDULED": { "label": "Курьер назначен",        "tone": "info" },
    "COURIER_EN_ROUTE":  { "label": "Курьер в пути",          "tone": "info" },
    "ITEM_PICKED_UP":    { "label": "Изделие у курьера",      "tone": "info" },
    "ITEM_DELIVERED":    { "label": "В ломбарде",             "tone": "info" },
    "INSPECTED":         { "label": "Осмотрено",              "tone": "success" },
    "FUNDS_ISSUED":      { "label": "Деньги выданы",          "tone": "success" },
    "LOAN_ACTIVE":       { "label": "Займ действует",         "tone": "success" },
    "EXTENDED":          { "label": "Продлён",                "tone": "success" },
    "OVERDUE":           { "label": "Просрочка",              "tone": "danger" },
    "REPAID":            { "label": "Погашен",                "tone": "neutral" },
    "ITEM_RETURNED":     { "label": "Изделие возвращено",     "tone": "neutral" },
    "FORFEITED":         { "label": "Перешло ломбарду",       "tone": "danger" }
  },
  "tone": {
    "neutral": { "bg": "neutral-100", "fg": "neutral-700", "dot": "graphite-400" },
    "info":    { "bg": "info-100",    "fg": "info-700",    "dot": "info-700" },
    "success": { "bg": "success-100", "fg": "success-700", "dot": "success-700" },
    "warning": { "bg": "warning-100", "fg": "warning-700", "dot": "warning-700" },
    "danger":  { "bg": "danger-100",  "fg": "danger-700",  "dot": "danger-700" },
    "gold":    { "bg": "gold-100",    "fg": "gold-700",    "dot": "gold-500" }
  }
}
