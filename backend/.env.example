# Скопируйте в backend/.env и при необходимости измените.
LOMBARD_ENVIRONMENT=development
LOMBARD_DEBUG=true
LOMBARD_DATABASE_URL=sqlite:///./lombard.db
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/lombard (нужен пакет psycopg)
LOMBARD_DB_ECHO=false
LOMBARD_UPLOAD_DIR=./uploads
# Фото заявки: не больше 6 шт. по 10 МБ; подписанные ссылки на фото живут 1 час
LOMBARD_MAX_PHOTOS=6
LOMBARD_MAX_PHOTO_MB=10
LOMBARD_PHOTO_URL_TTL_SECONDS=3600
LOMBARD_OFFER_TTL_HOURS=72
# Слоты курьера (время Казахстана): 10:00–20:00 по 2 ч, не раньше чем через 2 ч, на 7 дней вперёд
LOMBARD_COURIER_DAY_START_HOUR=10
LOMBARD_COURIER_DAY_END_HOUR=20
LOMBARD_COURIER_SLOT_HOURS=2
LOMBARD_COURIER_LEAD_HOURS=2
LOMBARD_COURIER_HORIZON_DAYS=7
# Займ: льготный период после срока (потом изделие переходит ломбарду), лимит продлений
LOMBARD_GRACE_PERIOD_DAYS=30
LOMBARD_MAX_LOAN_EXTENSIONS=5
# «Перемотка времени» (POST /api/admin/clock) для демо; по умолчанию включена только в
# development/test. true/false — принудительно.
# LOMBARD_TIME_TRAVEL=false
# Обязательно смените вне локальной разработки:
LOMBARD_SECRET_KEY=dev-insecure-secret-change-me-in-production
LOMBARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOMBARD_ACCESS_TOKEN_TTL_MINUTES=30
LOMBARD_REFRESH_TOKEN_TTL_DAYS=14
