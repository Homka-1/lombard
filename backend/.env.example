# Скопируйте в backend/.env и при необходимости измените.
LOMBARD_ENVIRONMENT=development
LOMBARD_DEBUG=true
LOMBARD_DATABASE_URL=sqlite:///./lombard.db
LOMBARD_UPLOAD_DIR=./uploads
# Обязательно смените вне локальной разработки:
LOMBARD_SECRET_KEY=change-me-in-production
LOMBARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
